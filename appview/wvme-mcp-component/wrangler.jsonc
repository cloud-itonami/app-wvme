{
  "name": "kotodama-vyie6ivw",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"createScan\",\"listScans\",\"getScan\",\"listVulnerabilities\",\"getVulnerability\",\"createRemediation\",\"listRemediations\",\"getScanReport\"]",
    "APP_DESCRIPTION": "wvme — Vulnerability Management & Security Scanning Platform. Automated security scanning, vulnerability lifecycle management, remediation workflows, and compliance reporting.",
    "APP_DISPLAY_NAME": "WVME",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "vyie6ivw",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "vyie6ivw.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "wvme.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
